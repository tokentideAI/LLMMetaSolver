+def _apply_prompt_overrides(messages):
+    """Optional prompt wrapping for self-hosted models (unset = original FrontierOR prompt).
+
+    FRONTIER_OR_SYSTEM_PROMPT_FILE: prepended as a system message (e.g. the SDRL
+    strategy-routing system prompt). FRONTIER_OR_USER_SUFFIX: appended to every
+    user message (e.g. "/no_think" for Qwen3 hybrid-thinking chat templates).
+    """
+    system_file = os.environ.get("FRONTIER_OR_SYSTEM_PROMPT_FILE")
+    suffix = os.environ.get("FRONTIER_OR_USER_SUFFIX", "")
+    if not system_file and not suffix:
+        return messages
+    out = []
+    if system_file and not (messages and messages[0].get("role") == "system"):
+        out.append({"role": "system", "content": Path(system_file).read_text(encoding="utf-8").strip()})
+    for m in messages:
+        if suffix and m.get("role") == "user" and isinstance(m.get("content"), str):
+            m = {**m, "content": m["content"].rstrip() + "\n" + suffix}
+        out.append(m)
+    return out
+

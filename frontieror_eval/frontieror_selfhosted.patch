+def _save_raw_response(log_path, stage, model, payload, data, latency_s):
+    """Append one raw LLM exchange to ``log_path`` (JSONL, one object per call).
+
+    Stores the exact request messages sent (after prompt overrides), the full
+    response text before code extraction (content plus any reasoning field),
+    finish_reason and usage. On by default; FRONTIER_OR_SAVE_RESPONSES=0 disables.
+    """
